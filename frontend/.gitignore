# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
# Любая параллельная сборка через NEXT_DIST_DIR (см. next.config.ts): мок-набор
# собирается в `.next-mock`, отдельные проверки — в свои каталоги.
#
# Игнорировать их ОБЯЗАТЕЛЬНО не только ради чистоты git: Tailwind v4 определяет,
# что сканировать, по .gitignore. Не игнорируемый каталог сборки он читает как
# исходники и вытаскивает из СГЕНЕРИРОВАННОГО CSS имена классов — включая те,
# которых в коде уже нет. Так в свежий бандл возвращались утилиты вида
# `[.anoon-desktop_&]:grid-cols-2` из чужой промежуточной сборки: в исходниках
# ноль вхождений, а в CSS они есть и действуют на телефоне.
.next-*/
out/
build/
dist/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

