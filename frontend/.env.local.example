# frontend — local environment (copy to .env.local and adjust)
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.

# anoon engine — WebSocket endpoint the tinode-sdk connects to.
# Our self-hosted "anoon-tinode" build listens on 6061 (see server-stack/).
NEXT_PUBLIC_TINODE_WS=ws://localhost:6061/v0/channels

# API key the Tinode server accepts (default self-hosted/demo key).
NEXT_PUBLIC_TINODE_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K

# Feature flag: "1" makes auth hit the REAL Tinode server (connect + basic
# account create/login). Anything else keeps the mock flow so the UI works
# with no backend running. Off by default.
NEXT_PUBLIC_USE_TINODE=0

# Single-origin / phone-test mode. "1" makes the app ignore the absolute
# TINODE_WS / COMPANION_URL hosts and talk to its OWN origin over relative paths
# (REST /api, companion WS wss://<host>/api/ws, tinode WS wss://<host>/v0/channels).
# Use it behind the server-stack/Caddyfile reverse proxy + Cloudflare Tunnel so a
# changing tunnel URL never breaks anything (see server-stack/PHONE-TEST.md).
# Leave unset / "0" for normal localhost dev.
NEXT_PUBLIC_SAME_ORIGIN=0

# Companion service (Go) — REST + WebSocket base URL.
# Owns login/OAuth, roulette, friends, reports, money and anoon events.
# While :6062 is down, the companion client auto-falls back to an in-memory mock
# driver (simulated matched/reveal events), so the roulette flow stays demoable
# end-to-end even with NEXT_PUBLIC_USE_TINODE=1 and no backend running.
NEXT_PUBLIC_COMPANION_URL=http://localhost:6062

# TURN relay for calls (WebRTC), on top of the public STUN servers baked into
# RTC_CONFIG. Public STUN alone can't establish a media path when both call
# peers are behind symmetric NATs — a TURN relay is the fallback for that case.
# All three must be set for the relay to be added; leave unset for STUN-only
# (the default). The coturn server itself is provisioned by the deploy side
# (see server-stack/, W3-3) — these just point the browser at it.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USER=
# NEXT_PUBLIC_TURN_PASS=
