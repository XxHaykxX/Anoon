# anoon-admin — переменные окружения (ПРИМЕР).
# Скопируй в `.env` и заполни реальными значениями. `.env` в .gitignore — НЕ коммить.
# ВАЖНО: ключи БЕЗ префикса NEXT_PUBLIC_ остаются на сервере (не попадают в бандл).
# Никогда не ставь secret / service-role ключи в NEXT_PUBLIC_*.

# --- Источник данных admin-API (server-only) ---
# companion = реальный companion REST-бэкенд anoon; supabase = устаревший/fallback путь.
# По умолчанию (не задано) = supabase, чтобы существующее поведение не ломалось.
ADMIN_BACKEND="supabase"

# --- Companion admin-API (server-only; нужен при ADMIN_BACKEND=companion) ---
COMPANION_ADMIN_URL="http://localhost:6062"        # dev; в проде — внутренний DNS companion
COMPANION_ADMIN_SECRET="change-me-shared-admin-secret"  # shared-secret заголовок, НИКОГДА в клиент

# --- Supabase (server-only; тот же проект, что у web/backend) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<supabase-secret-key>"   # secret (bypass RLS), НИКОГДА в клиент

# --- Admin-аутентификация (отдельная система, НЕ пользовательский JWT) ---
# Секрет для подписи httpOnly-cookie сессии (jose HS256). >=32 символов, случайный.
ADMIN_SESSION_SECRET="change-me-strong-random-32-chars-min"

# --- Бутстрап первого админа (scripts/create-admin.mjs) ---
# ADMIN_PASSWORD используется ТОЛЬКО при создании админа; в БД хранится argon2-хэш,
# а не открытый пароль. После бутстрапа очисти это значение.
ADMIN_EMAIL="admin@anoon.app"
ADMIN_PASSWORD="change-me-strong"

# --- Режим данных ---
# mock = UI на фикстурах без бэкенда; api = реальный admin-API (Supabase)
NEXT_PUBLIC_DATA_MODE="mock"

# --- Vercel (генерируется автоматически в .env.local; здесь для справки) ---
# VERCEL_OIDC_TOKEN="<auto-generated-by-vercel-cli>"
