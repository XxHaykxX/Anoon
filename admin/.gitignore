# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# The api/companion build lives in its own dir so it can never be mixed with a
# mock-mode one: NEXT_PUBLIC_DATA_MODE is inlined at BUILD time, and a build on
# top of the other mode's output produces a hybrid that lies about which backend
# it talks to. Same reason frontend/ ignores `.next-*`.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. Keep only .env.example (placeholders).
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
