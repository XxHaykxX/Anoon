# Multi-stage build for the anoon companion service.
# Stage 1: compile a static binary. Stage 2: distroless runtime.

# ---- build ----
FROM golang:1.23-alpine AS build
WORKDIR /src

# Cache module downloads. go.sum is generated by `go mod tidy`; if it is not
# present yet the build still resolves modules (network required at build time).
COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .

# Static, stripped binary. CGO off — all deps (pgx, grpc, gorilla) are pure Go.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/companion .

# ---- runtime ----
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/companion /companion

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/companion"]
