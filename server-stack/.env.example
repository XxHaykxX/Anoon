# Copy to `.env` and fill in real values. Never commit `.env` — only this
# example file with placeholders. See docker-compose.yml for how these are
# consumed and companion/README.md / internal/config/config.go for defaults.

# --- Postgres -----------------------------------------------------------
POSTGRES_PASSWORD=changeme

# --- Tinode server keys (see server/ for how these are generated) --------
API_KEY_SALT=changeme
AUTH_TOKEN_KEY=changeme
UID_ENCRYPTION_KEY=changeme

# --- Tinode DB lifecycle (leave at defaults unless you know you need them) -
RESET_DB=false
UPGRADE_DB=false
SAMPLE_DATA=data.json

# --- Companion: ROOT bot (acts on_behalf_of any user; see README) --------
COMPANION_ROOT_LOGIN=root
COMPANION_ROOT_SECRET=changeme

# --- Companion: environment gate -----------------------------------------
# "dev" or "prod". In prod, the service refuses to start if COMPANION_DEV_AUTH
# is on, and requires CORS_ALLOWED_ORIGINS to be set explicitly (no "*").
# Unset defaults to "prod" (fail closed), so local work must set dev here.
ENV=dev

# --- Companion: dev auth bypass (X-Anoon-Uid / X-Anoon-Hash-Id) -----------
# DEV ONLY. Leave off (0) unless you're exercising the API without a real
# Tinode login token. Cannot be enabled together with ENV=prod — the service
# will refuse to start rather than silently ignore it.
COMPANION_DEV_AUTH=0

# --- Companion: admin API shared secret ----------------------------------
# Empty disables the /admin/* API entirely. Must match the admin service's
# COMPANION_ADMIN_SECRET.
COMPANION_ADMIN_SECRET=

# --- Companion: admin operator tokens (optional) --------------------------
# HMAC key companion verifies per-operator admin tokens (X-Admin-Token) with.
# Must equal the admin UI's ADMIN_SESSION_SECRET — it is the same HS256 key the
# admin service already signs its session with.
# EMPTY = legacy mode, the shipped default: the acting operator id and role come
# from the X-Admin-Id / X-Admin-Role headers, which anyone holding
# COMPANION_ADMIN_SECRET can set. Legacy mode stays fully supported; setting
# this only upgrades operator id/role from asserted to attested.
# When set it must be >=16 characters (companion refuses to start below that,
# matching the admin service) — a truncated key would 401 every admin request.
COMPANION_ADMIN_TOKEN_SECRET=

# --- Companion: Tinode rest-auth hook secret ------------------------------
# Shared secret Tinode must present on POST /auth/rest (the callback its `rest`
# auth scheme makes for Google sign-in). Empty disables the hook (503), which
# is fine until the Tinode rest auth block is configured. Hex only — it is
# embedded in Tinode's rest server_url. Generate: openssl rand -hex 32
COMPANION_REST_SECRET=

# --- Companion: CORS allowlist -------------------------------------------
# Comma-separated. Entries are exact origins ("http://localhost:3001") or a
# "*.suffix" wildcard ("*.trycloudflare.com" for phone-testing tunnels).
# Left empty: dev falls back to localhost + *.trycloudflare.com; prod refuses
# to start (must be set explicitly, and may not contain "*").
CORS_ALLOWED_ORIGINS=

# --- Companion: roulette anti-repeat window ------------------------------
# Go duration string, e.g. "2h", "30s", "0" (disables the exclusion — handy
# for testing with only a couple of accounts).
ROULETTE_RECENT_WINDOW=2h

# --- Companion: Web Push (VAPID) -----------------------------------------
# Empty keys disable push entirely (no-op). Generate a real P-256 keypair
# before relying on this (see companion/README.md).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@anoon.app

# --- Companion: temp-ban expiry sweep ------------------------------------
# Go duration string; <=0 disables the background job.
BAN_SWEEP_INTERVAL=60s

# --- Companion: payments (#14) -------------------------------------------
# Which payment provider is live. EMPTY (the default) disables billing
# entirely: the /billing/* routes are not mounted at all, which is correct
# until a provider is actually signed — see docs/PAYMENTS-PLAN.md §5-6
# (Ameriabank vPOS is the recommendation, Idram the likely second).
#
# "fake" selects the local sandbox: it settles orders with an HMAC-signed
# callback and no third party, so the whole flow (order → hosted page →
# callback → coins) can be exercised without anyone's real keys. It is REFUSED
# when ENV=prod — its signing key is in this file, and that key mints coins.
#
# When a real provider is signed, its merchant id / secret / terminal keys get
# their own vars here, as placeholders only. Real values live in the deployed
# environment and never in the repo.
BILLING_PROVIDER=
# HMAC key the sandbox callback is signed with. Required when BILLING_PROVIDER
# is "fake", meaningless otherwise. Generate: openssl rand -hex 32
BILLING_FAKE_SECRET=
# Public origin of the companion service, used to build the sandbox checkout
# URL (a real provider hosts its own payment page instead).
BILLING_BASE_URL=http://127.0.0.1:6062
# How long an unpaid order stays payable (Go duration). After this the order is
# terminal and a late callback becomes a refund case, not a grant.
BILLING_ORDER_TTL=30m

# --- Companion: rate limiting / abuse guard ------------------------------
# Token-bucket limiter on the public endpoints (auth, roulette enqueue,
# reports, friend search), keyed per user AND per client IP. Unset or <=0
# disables it entirely (the lenient default). RATE_LIMIT_BURST defaults to
# max(2*RPS, 10) when only RPS is set.
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=

# --- Companion: outbound email (password reset / verify, #116) -----------
# SMTP is currently STUBBED — reset/verify emails are logged, not sent. These
# are placeholders so a real transport can be wired later (internal/mail) with
# no other change. Safe to leave empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@anoon.app
