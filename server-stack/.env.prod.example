# =============================================================================
# anoon — PRODUCTION environment template (for compose.prod.yml)
#
#   cp .env.prod.example .env     # on the server, in /opt/anoon/server-stack
#   chmod 600 .env                # then fill in real values
#
# EVERY value below is a placeholder. Generate FRESH prod secrets — never reuse
# dev values, never commit the filled-in .env (it is git-ignored).
# Keep an offline copy of the filled file in a password manager.
# =============================================================================

# ---- Public identity --------------------------------------------------------
# The one public domain the whole app is served from (no scheme, no slash).
# DNS A (and AAAA if you have IPv6) records must point at the server BEFORE
# first start, or Let's Encrypt issuance fails.
DOMAIN=app.example.com
# Contact email for the Let's Encrypt (ACME) account — cert expiry notices.
ACME_EMAIL=admin@example.com
# Companion CORS allowlist (comma-separated exact origins, scheme included).
# Single-origin setup → just the app origin. Add the admin origin when the
# admin panel goes live (e.g. https://admin.example.com).
CORS_ALLOWED_ORIGINS=https://app.example.com

# ---- Postgres ---------------------------------------------------------------
# Superuser password for the in-stack postgres (never exposed off-network).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---- Tinode security keys ---------------------------------------------------
# ALL THREE must be fresh prod values (dev values are burned / upstream-known).
#
# API_KEY_SALT: MUST be rotated off the upstream default before launch.
#   Generate: openssl rand -base64 32
# Then generate the matching client api-key with Tinode's keygen tool
# (built from source: go build ./keygen, run with the new salt) and put the
# result in TINODE_API_KEY below. Salt and api-key only work as a pair.
API_KEY_SALT=CHANGE_ME_openssl_rand_base64_32
# Client api-key produced by keygen with the salt above. Baked into the
# frontend image at BUILD time — rebuild frontend after changing it.
TINODE_API_KEY=CHANGE_ME_keygen_output
# HMAC key for Tinode auth tokens. Rotating later = all users logged out.
#   Generate: openssl rand -base64 32
AUTH_TOKEN_KEY=CHANGE_ME_openssl_rand_base64_32
# UID obfuscation key. Set ONCE and NEVER change: rotation breaks every
# existing user id. Generate: openssl rand -base64 16
UID_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_16

# ---- Companion --------------------------------------------------------------
# ROOT bot account: register it via POST /auth/register on first deploy, then
# promote with Tinode's init-db --make_root (see DEPLOY-PROD.md step 6).
COMPANION_ROOT_LOGIN=anoonbot
# Generate: openssl rand -base64 24  (strip any '=' padding for tidiness)
COMPANION_ROOT_SECRET=CHANGE_ME_openssl_rand_base64_24
# Shared secret between the admin panel and the companion /admin/* API.
# Leave EMPTY to keep the admin API disabled until the panel is deployed.
# Generate: openssl rand -base64 24
COMPANION_ADMIN_SECRET=
# Google OAuth client id (PROD client, with https://<DOMAIN> redirect URI,
# from Google Cloud Console). Empty disables Google sign-in.
COMPANION_GOOGLE_CLIENT_ID=
# Roulette anti-repeat window (Go duration). Prod default: 2h.
ROULETTE_RECENT_WINDOW=2h
# Temp-ban expiry sweep interval; <=0 disables the background job.
BAN_SWEEP_INTERVAL=60s

# ---- Web Push (VAPID) -------------------------------------------------------
# Generate a FRESH prod P-256 keypair (webpush-go GenerateVAPIDKeys, or:
#   npx web-push generate-vapid-keys
# ). Public key is safe to expose; private key is a secret. Both empty = push
# disabled (safe no-op).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact claim (mailto: or https:) push services may use to reach you.
VAPID_SUBJECT=mailto:admin@example.com

# ---- TURN relay (coturn) — WebRTC calls behind NAT ----------------------------
# Long-term-credential auth with ONE static user. These same values are baked
# into the frontend bundle (NEXT_PUBLIC_TURN_* below), i.e. they are PUBLIC by
# design — server-side quotas/denied-peer ranges bound the abuse (see
# coturn/turnserver.conf). Rotate occasionally: change here + rebuild frontend.
TURN_USER=anoon
# Generate: openssl rand -hex 16
TURN_PASS=CHANGE_ME_openssl_rand_hex_16
# TURN realm — use the app domain.
TURN_REALM=app.example.com

# Frontend copies (read by RTC_CONFIG at BUILD time — keep in sync with the
# three values above; changing any of them requires a frontend image rebuild).
# turn:<DOMAIN>:3478 covers UDP+TCP; clients fall back to turns:<DOMAIN>:5349
# (TLS) on networks that block 3478.
NEXT_PUBLIC_TURN_URL=turn:app.example.com:3478
NEXT_PUBLIC_TURN_USER=anoon
NEXT_PUBLIC_TURN_PASS=CHANGE_ME_same_as_TURN_PASS

# ---- DB lifecycle (leave false in normal operation) --------------------------
# UPGRADE_DB=true only when bumping the Tinode version — BACK UP FIRST.
# RESET_DB=true WIPES the tinode database. Never on live prod.
RESET_DB=false
UPGRADE_DB=false

# ---- Build layout override (usually not needed) ------------------------------
# Path of the frontend frontend relative to server-stack/. The server layout
# (/opt/anoon/{server,server-stack,frontend}) matches the default; on a dev
# workstation with frontend one level higher use: FRONTEND_DIR=../../frontend
#FRONTEND_DIR=../frontend
